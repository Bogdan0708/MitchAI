    {
      "parameters": {
        "jsCode": "// Handle combination workflows\nconst input = $input.item.json.payload;\nconst comboType = input.combo_type;\n\n// Define combination workflows\nconst combos = {\n  'new_item_launch': {\n    description: 'Create menu item + social content',\n    steps: [\n      {\n        workflow: 'menu',\n        params: {\n          workflow_type: 'new_items',\n          cuisine_style: input.cuisine_style || 'Traditional Transylvanian',\n          target_audience: input.target_audience || 'locals and tourists',\n          price_range: input.price_range || '25-40 RON'\n        }\n      },\n      {\n        workflow: 'social',\n        params: {\n          content_type: 'instagram_post',\n          topic: 'New menu item launch'\n        }\n      }\n    ]\n  },\n  'feedback_action': {\n    description: 'Analyze feedback + create strategy',\n    steps: [\n      {\n        workflow: 'feedback',\n        params: {\n          feedback_type: 'trend_analysis',\n          feedback_batch: input.feedback_data\n        }\n      },\n      {\n        workflow: 'strategy',\n        params: {\n          strategy_type: 'menu_optimization',\n          feedback_insights: 'from_previous_step'\n        }\n      }\n    ]\n  },\n  'daily_startup': {\n    description: 'Morning operations + social + menu check',\n    steps: [\n      {\n        workflow: 'operations',\n        params: {\n          operation_type: 'daily_checklist',\n          shift: 'morning',\n          day_of_week: new Date().toLocaleDateString('en-US', { weekday: 'long' })\n        }\n      },\n      {\n        workflow: 'social',\n        params: {\n          content_type: 'instagram_post',\n          topic: \"Today's special\"\n        }\n      },\n      {\n        workflow: 'menu',\n        params: {\n          workflow_type: 'seasonal',\n          season: input.season || 'current'\n        }\n      }\n    ]\n  },\n  'weekly_review': {\n    description: 'Full business review',\n    steps: [\n      {\n        workflow: 'feedback',\n        params: {\n          feedback_type: 'trend_analysis',\n          feedback_batch: input.weekly_feedback\n        }\n      },\n      {\n        workflow: 'operations',\n        params: {\n          operation_type: 'waste_reduction',\n          waste_data: input.waste_data\n        }\n      },\n      {\n        workflow: 'strategy',\n        params: {\n          strategy_type: 'menu_optimization',\n          data_period: 'last_week'\n        }\n      },\n      {\n        workflow: 'social',\n        params: {\n          content_type: 'weekly_calendar',\n          theme: 'Based on weekly insights'\n        }\n      }\n    ]\n  }\n};\n\nconst selectedCombo = combos[comboType] || combos['new_item_launch'];\n\nreturn {\n  json: {\n    combo_type: comboType,\n    combo_config: selectedCombo,\n    execution_plan: selectedCombo.steps,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "REDACTED",
      "name": "Combination Workflow Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        1300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Execute combination workflows in sequence\nconst executionPlan = $input.item.json.execution_plan;\nconst results = [];\n\nfor (const step of executionPlan) {\n  const url = `http://localhost:5678/webhook/${step.workflow === 'menu' ? 'menu-innovation' : \n                                           step.workflow === 'social' ? 'social-content' :\n                                           step.workflow === 'strategy' ? 'business-strategy' :\n                                           step.workflow === 'feedback' ? 'customer-feedback' :\n                                           'daily-operations'}`;\n  \n  results.push({\n    step: step.workflow,\n    url: url,\n    params: step.params,\n    status: 'pending'\n  });\n}\n\nreturn { json: { results: results } };"
      },
      "id": "REDACTED",
      "name": "Execute Combo Steps",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
