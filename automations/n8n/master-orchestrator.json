      "parameters": {
        "jsCode": "// Route to appropriate workflow based on request\nconst input = $input.item.json.body ?? $input.item.json;\nconst workflow = input.workflow || 'unknown';\n\n// Workflow routing configuration\nconst routes = {\n  'menu': {\n    url: 'http://localhost:5678/webhook/menu-innovation',\n    description: 'Menu Innovation Engine'\n  },\n  'social': {\n    url: 'http://localhost:5678/webhook/social-content',\n    description: 'Social Media Generator'\n  },\n  'strategy': {\n    url: 'http://localhost:5678/webhook/business-strategy',\n    description: 'Business Strategy Advisor'\n  },\n  'feedback': {\n    url: 'http://localhost:5678/webhook/customer-feedback',\n    description: 'Customer Feedback Analyzer'\n  },\n  'operations': {\n    url: 'http://localhost:5678/webhook/daily-operations',\n    description: 'Daily Operations Assistant'\n  },\n  'combo': {\n    description: 'Multi-workflow orchestration'\n  }\n};\n\nreturn {\n  json: {\n    workflow: workflow,\n    route: routes[workflow] || routes['unknown'],\n    payload: input,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
