# =============================================================================
# Hospitality SaaS - GCP Environment Configuration
# =============================================================================
# This file contains environment variables for GCP deployment.
# Copy to .env.gcp and fill in your values.
# NEVER commit .env.gcp to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# GCP Project Configuration
# -----------------------------------------------------------------------------

GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Artifact Registry (auto-generated from Terraform)
ARTIFACT_REGISTRY_URL=${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/hospitality-saas-prod-docker

# -----------------------------------------------------------------------------
# Database (Cloud SQL)
# -----------------------------------------------------------------------------
# These values are managed by Terraform and Secret Manager.
# Use `gcloud secrets versions access latest --secret=hospitality-saas-prod-db-connection-string`
# to retrieve the connection string.

# For local development against Cloud SQL (via Cloud SQL Auth Proxy):
# 1. Run: cloud-sql-proxy PROJECT_ID:REGION:INSTANCE_NAME --port=5432
# 2. Use: DATABASE_URL=postgresql://hospitality_admin:PASSWORD@localhost:5432/hospitality_db

# -----------------------------------------------------------------------------
# Redis (on n8n VM)
# -----------------------------------------------------------------------------
# Internal IP retrieved from Terraform output: terraform output n8n_vm_internal_ip

REDIS_URL=redis://10.0.0.X:6379

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Managed by Secret Manager. Retrieve with:
# gcloud secrets versions access latest --secret=hospitality-saas-prod-jwt-secret

# JWT_SECRET=<from-secret-manager>

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Add your Stripe keys to Secret Manager:
# gcloud secrets versions add hospitality-saas-prod-stripe-secret-key --data-file=-
# gcloud secrets versions add hospitality-saas-prod-stripe-webhook-secret --data-file=-

STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# For Stripe CLI webhook testing:
# stripe listen --forward-to localhost:3000/webhooks/stripe

# -----------------------------------------------------------------------------
# AI Providers
# -----------------------------------------------------------------------------
# Add API keys to Secret Manager:
# echo -n "sk-xxx" | gcloud secrets versions add hospitality-saas-prod-openai-api-key --data-file=-

OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
PERPLEXITY_API_KEY=pplx-xxx

# Local AI (optional - for development)
# LM_STUDIO_URL=http://localhost:1234/v1
# OLLAMA_URL=http://localhost:11434
# ENABLE_LOCAL_AI=false
# LOCAL_AI_FIRST=false

DEFAULT_AI_PROVIDER=openai
AI_ENABLE_FALLBACK=true

# -----------------------------------------------------------------------------
# Email (SendGrid)
# -----------------------------------------------------------------------------

SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Hospitality SaaS

# -----------------------------------------------------------------------------
# Vector Database (Qdrant Cloud)
# -----------------------------------------------------------------------------
# Sign up at https://cloud.qdrant.io and create a cluster.

QDRANT_URL=https://xxx.qdrant.tech
QDRANT_API_KEY=xxx

# -----------------------------------------------------------------------------
# n8n Configuration
# -----------------------------------------------------------------------------
# Managed by Terraform. Access via external IP from output.

N8N_USER=admin
# N8N_PASSWORD=<from-secret-manager>
# N8N_URL=http://EXTERNAL_IP:5678

# -----------------------------------------------------------------------------
# AWS (Optional - for S3 exports)
# -----------------------------------------------------------------------------

# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_REGION=us-east-1
# S3_BUCKET=hospitality-saas-exports

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# CORS - Update with your actual domains
CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Frontend API URL (Cloud Run URL or custom domain)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Google Cloud Monitoring is enabled by default for Cloud Run services
