{
  "family": "mitch-dev-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::337270123670:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "mitch-dev-api",
      "image": "337270123670.dkr.ecr.eu-west-2.amazonaws.com/mitch-dev-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3000/ping || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "https://mitchfromtransylvania.com,https://www.mitchfromtransylvania.com,https://master.d19ti5682xc8uc.amplifyapp.com"
        },
        {
          "name": "AI_SERVICE_URL",
          "value": "https://mitch-ai-382299704849.europe-west2.run.app"
        },
        {
          "name": "LOCAL_LLM_URL",
          "value": "https://lm.mitchfromtransylvania.com/v1"
        },
        {
          "name": "LM_STUDIO_URL",
          "value": "https://lm.mitchfromtransylvania.com/v1"
        },
        {
          "name": "ENABLE_LOCAL_AI",
          "value": "false"
        },
        {
          "name": "LOCAL_AI_FIRST",
          "value": "false"
        },
        {
          "name": "STRIPE_PRICE_STARTER_MONTHLY",
          "value": "price_1SytrfLwJisplivCtM3o0kdU"
        },
        {
          "name": "STRIPE_PRICE_PRO_MONTHLY",
          "value": "price_1SytxkLwJisplivCSiqx9VJ0"
        },
        {
          "name": "STRIPE_PRICE_ENTERPRISE_MONTHLY",
          "value": "price_1Syu6WLwJisplivCnnWOYBDw"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:337270123670:secret:mitch/database-url-STd3BM"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:337270123670:secret:mitch/redis-url-Mp3xb2"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:337270123670:secret:mitch/jwt-secret-MJy3Ob"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:337270123670:secret:mitch/stripe-secret-key-RGyrPD"
        },
        {
          "name": "STRIPE_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:337270123670:secret:mitch/stripe-webhook-secret-9cfnwP"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:337270123670:secret:mitch/openai-api-key-Wy16ba"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:337270123670:secret:mitch/anthropic-api-key-YA2rIC"
        },
        {
          "name": "SQUARE_ACCESS_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:337270123670:secret:mitch/square-access-token-Lwb4KS"
        },
        {
          "name": "SQUARE_APP_ID",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:337270123670:secret:mitch/square-app-id-RQgGQf"
        },
        {
          "name": "SENTRY_DSN",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:337270123670:secret:mitch/sentry-dsn-GtmeSq"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mitch-dev-api",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "taskRoleArn": "arn:aws:iam::337270123670:role/mitch-api-task-role"
}
