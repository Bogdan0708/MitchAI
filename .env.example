# Database
# IMPORTANT: Generate secure password with: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND
DATABASE_URL=postgres://hospitality_admin:CHANGE_ME_USE_OPENSSL_RAND@localhost:5433/hospitality_db

# Redis
REDIS_URL=redis://localhost:6380

# JWT
# IMPORTANT: Generate secure secret with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# AI Providers - Cloud
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GOOGLE_AI_KEY=xxx
PERPLEXITY_API_KEY=pplx-xxx

# AI Providers - Local
LM_STUDIO_URL=http://localhost:1234/v1
OLLAMA_URL=http://localhost:11434
ENABLE_LOCAL_AI=true
LOCAL_AI_FIRST=false

# AI Router Configuration
DEFAULT_AI_PROVIDER=openai
AI_ENABLE_FALLBACK=true

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@mitch-ai.com
EMAIL_FROM_NAME=Mitch AI Platform

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# n8n
N8N_USER=admin
# IMPORTANT: Generate secure password with: openssl rand -base64 16 | tr -d '/+='
N8N_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND

# Grafana
# IMPORTANT: Generate secure password with: openssl rand -base64 16 | tr -d '/+='
GRAFANA_PASSWORD=CHANGE_ME_USE_OPENSSL_RAND

# AWS (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET=hospitality-saas-uploads
